# =============================================================================
# Growth Room — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=growthroom
POSTGRES_USER=growthroom
POSTGRES_PASSWORD=changeme_dev

DATABASE_URL=postgresql+psycopg2://growthroom:changeme_dev@postgres:5432/growthroom

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=info

# --- LLM (placeholder — fill in when wiring agent) ---
OPENAI_API_KEY=sk-replace-me
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Knowledge Base ---
ENABLE_DEBUG_ENDPOINTS=true
TRANSCRIPT_REPO_URL=https://github.com/ChatPRD/lennys-podcast-transcripts.git
TRANSCRIPT_REPO_PATH=./transcript_repo
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
